# ---- Images (pulled from registries, nothing is built locally) ----
SPARK_IMAGE=apache/spark:3.5.3
# minio/minio is no longer published on Docker Hub; this image ships both minio and mc.
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r3

# ---- MinIO ----
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
BUCKET=lab
DATA_PATH=parquet/test

# ---- Cluster (standalone) ----
# Number of worker containers.
WORKER_REPLICAS=2
# Cores and memory advertised by each worker.
WORKER_CORES=4
WORKER_MEMORY=2g
# spark.executor.cores / spark.executor.memory. Executors per worker = WORKER_CORES / EXECUTOR_CORES.
EXECUTOR_CORES=2
EXECUTOR_MEMORY=1g
# Executors requested in total; translated to spark.cores.max = NUM_EXECUTORS * EXECUTOR_CORES.
NUM_EXECUTORS=4
DRIVER_MEMORY=512m

# ---- Data generation (make gen) ----
# Total columns; types cycle long, double, string.
TOTAL_COLUMNS=30
# One Parquet file per partition: file count and rows per file determine file size.
NUM_FILES=1
ROWS_PER_FILE=4800000
# parquet.block.size (row group size, uncompressed in-memory target).
ROW_GROUP_SIZE_MB=64
# parquet.page.size.
PAGE_SIZE_KB=1024
# snappy | zstd | gzip | none
COMPRESSION=snappy

# ---- Read (make read) ----
# Read only the first N columns (c0..cN-1); exercises column pruning.
READ_COLUMNS=5
# spark.sql.files.maxPartitionBytes / spark.sql.files.openCostInBytes: control split sizing.
MAX_PARTITION_MB=128
OPEN_COST_MB=4
# Keep the driver (and its UI on :4040) alive this many seconds after the query finishes.
HOLD_SECONDS=0
