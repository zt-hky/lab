# ---------- Images (có sẵn trên Docker Hub, không build) ----------
SPARK_IMAGE=apache/spark:3.5.3
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r3  # minio/minio không còn trên Docker Hub; image này có cả minio + mc

# ---------- MinIO ----------
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
BUCKET=lab
DATA_PATH=parquet/test

# ---------- Cluster ----------
WORKER_REPLICAS=2        # số worker container
WORKER_CORES=4           # core mỗi worker
WORKER_MEMORY=2g         # ram mỗi worker
EXECUTOR_CORES=2         # core mỗi executor  -> executors/worker = WORKER_CORES/EXECUTOR_CORES
EXECUTOR_MEMORY=768m      # heap mỗi executor
NUM_EXECUTORS=4          # tổng executor muốn dùng (spark.cores.max = NUM_EXECUTORS*EXECUTOR_CORES)
DRIVER_MEMORY=512m

# ---------- Dump dữ liệu (gen) ----------
TOTAL_COLUMNS=30         # tổng số column (cycle long/double/string)
NUM_FILES=8              # số file parquet
ROWS_PER_FILE=100000     # số row mỗi file
ROW_GROUP_SIZE_MB=64     # parquet.block.size (row group)
PAGE_SIZE_KB=1024        # parquet.page.size
COMPRESSION=snappy       # snappy|zstd|gzip|none

# ---------- Đọc (read) ----------
READ_COLUMNS=5           # chỉ đọc N column đầu (c0..cN-1)
MAX_PARTITION_MB=128     # spark.sql.files.maxPartitionBytes
OPEN_COST_MB=4           # spark.sql.files.openCostInBytes
HOLD_SECONDS=0           # giữ driver (Spark UI :4040) thêm N giây sau khi đọc xong
